# ---------- Discord (required) ----------
DISCORD_TOKEN=            # Bot token from the Discord Developer Portal
DISCORD_APP_ID=           # Application ID
DISCORD_GUILD_ID=         # ID of your private server
DISCORD_OWNER_ID=         # YOUR Discord user ID (only you can use the bot)

# ---------- Local AI model (Ollama) ----------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b     # use qwen3:4b on an 8 GB Mac
OLLAMA_THINK=false        # qwen3 "thinking" off = much faster. Remove this line for models without thinking
OLLAMA_NUM_CTX=8192

# ---------- ClickUp (optional - leave blank to disable) ----------
CLICKUP_TOKEN=            # pk_... personal API token
CLICKUP_TEAM_ID=          # optional; first workspace is used if blank
CLICKUP_POLL_MINUTES=5

# ---------- Gmail (optional - enabled once data/google-token.json exists) ----------
GMAIL_QUERY=in:inbox category:primary is:unread newer_than:2d
GMAIL_POLL_MINUTES=3
GMAIL_SUMMARIZE_NEW=true  # add a one-line AI triage to new-email alerts

# ---------- Behaviour ----------
TIMEZONE=Asia/Kolkata
SIGNATURE=Yogesh
DIGEST_CRON=0 9 * * 1-5   # daily plan at 09:00 Mon-Fri
QUIET_HOURS=22-8          # no reminders/alerts between 22:00 and 08:00

# ---------- Web dashboard (private, only reachable from this Mac) ----------
DASHBOARD_ENABLED=true
DASHBOARD_PORT=4747       # open with: npm run dashboard

# ---------- MCP server for Cursor / Claude Code (optional) ----------
# Approved team server for teammate lookup + DMs. The assistant bot must be a member.
# Discord tools refuse to work until this is set; no other server is ever used.
DISCORD_ALLOWED_GUILD_ID=
# dm_code (default, recommended): sending an email or Discord DM requires a 6-digit code the bot DMs to YOU.
# host_approval: relies only on Cursor/Claude Code asking you to approve the tool call (weaker).
MCP_CONFIRM_MODE=dm_code
MCP_CONFIRM_TTL_MINUTES=10
# Set to false to remove these abilities from Cursor/Claude Code (reads keep working).
MCP_ALLOW_EMAIL_SEND=true
MCP_ALLOW_CLICKUP_WRITES=true
